{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/engine/**", "src/ai/**", "src/personality/**", "src/state/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "message": "Game logic must stay framework-free." },
              { "name": "react-dom", "message": "Game logic must stay framework-free." },
              { "name": "framer-motion", "message": "Game logic must stay framework-free." }
            ],
            "patterns": [{ "group": ["**/ui/**"], "message": "Game logic must not import UI." }]
          }
        ]
      }
    }
  ]
}
